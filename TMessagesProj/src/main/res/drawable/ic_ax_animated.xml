<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="512dp"
            android:height="512dp"
            android:viewportWidth="512"
            android:viewportHeight="512">
            <group android:name="group">
                <!-- AxGram: letter "A" drawn with the two side legs first, then the crossbar. -->
                <path
                    android:name="leg_left"
                    android:strokeColor="#0095ff"
                    android:strokeWidth="64"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0"
                    android:pathData="M 256 118 L 150 394" />
                <path
                    android:name="leg_right"
                    android:strokeColor="#0095ff"
                    android:strokeWidth="64"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0"
                    android:pathData="M 256 118 L 362 394" />
                <path
                    android:name="cross"
                    android:strokeColor="#0095ff"
                    android:strokeWidth="64"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0"
                    android:pathData="M 187 300 L 325 300" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="leg_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="leg_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="cross">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="220"
                android:startOffset="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
